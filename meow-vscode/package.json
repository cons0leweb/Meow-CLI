{
  "name": "meow-vscode",
  "displayName": "Meow CLI — AI Agent for VSCode",
  "description": "The full power of Meow CLI v3 inside VSCode: streaming AI chat, inline code actions, RAG memory, autonomous autopilot, sub-agent delegation, and more.",
  "version": "1.0.0",
  "publisher": "meowcli",
  "icon": "media/icons/meow-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "copilot",
    "claude",
    "openai",
    "anthropic",
    "autopilot",
    "refactor",
    "chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "meow.openChat",
        "title": "Meow: Open AI Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "meow.explainCode",
        "title": "Meow: Explain Selected Code",
        "icon": "$(lightbulb)"
      },
      {
        "command": "meow.refactorCode",
        "title": "Meow: Refactor Selected Code",
        "icon": "$(tools)"
      },
      {
        "command": "meow.fixCode",
        "title": "Meow: Fix / Debug Selected Code",
        "icon": "$(debug)"
      },
      {
        "command": "meow.documentCode",
        "title": "Meow: Generate Documentation",
        "icon": "$(book)"
      },
      {
        "command": "meow.generateTests",
        "title": "Meow: Generate Tests for Selection",
        "icon": "$(beaker)"
      },
      {
        "command": "meow.reviewFile",
        "title": "Meow: Review Current File",
        "icon": "$(search)"
      },
      {
        "command": "meow.autopilot",
        "title": "Meow: Run Autopilot Task",
        "icon": "$(rocket)"
      },
      {
        "command": "meow.openMemory",
        "title": "Meow: Open RAG Memory Viewer",
        "icon": "$(database)"
      },
      {
        "command": "meow.openSessions",
        "title": "Meow: Browse Sessions",
        "icon": "$(history)"
      },
      {
        "command": "meow.runInTerminal",
        "title": "Meow: Run in Integrated Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "meow.openSettings",
        "title": "Meow: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "meow.newSession",
        "title": "Meow: New Chat Session",
        "icon": "$(add)"
      },
      {
        "command": "meow.compactHistory",
        "title": "Meow: Compact Chat History",
        "icon": "$(fold)"
      },
      {
        "command": "meow.inlineChat",
        "title": "Meow: Inline AI Chat at Cursor",
        "icon": "$(edit)"
      },
      {
        "command": "meow.analyzeProject",
        "title": "Meow: Analyze Entire Project",
        "icon": "$(graph)"
      },
      {
        "command": "meow.gitSummary",
        "title": "Meow: Summarize Git Changes",
        "icon": "$(source-control)"
      },
      {
        "command": "meow.applyDiff",
        "title": "Meow: Apply AI Suggested Diff",
        "icon": "$(diff)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "meow-sidebar",
          "title": "Meow AI Agent",
          "icon": "media/icons/meow-sidebar.svg"
        }
      ]
    },
    "views": {
      "meow-sidebar": [
        {
          "type": "webview",
          "id": "meow.chatView",
          "name": "AI Chat",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Meow AI Chat"
        },
        {
          "id": "meow.sessionsView",
          "name": "Sessions",
          "icon": "$(history)"
        },
        {
          "id": "meow.memoryView",
          "name": "RAG Memory",
          "icon": "$(database)"
        },
        {
          "id": "meow.toolsView",
          "name": "Tool Calls",
          "icon": "$(wrench)"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "submenu": "meow.editorContext",
          "group": "meow@1"
        }
      ],
      "meow.editorContext": [
        {
          "command": "meow.explainCode",
          "group": "meow@1",
          "when": "editorHasSelection"
        },
        {
          "command": "meow.refactorCode",
          "group": "meow@2",
          "when": "editorHasSelection"
        },
        {
          "command": "meow.fixCode",
          "group": "meow@3",
          "when": "editorHasSelection"
        },
        {
          "command": "meow.documentCode",
          "group": "meow@4",
          "when": "editorHasSelection"
        },
        {
          "command": "meow.generateTests",
          "group": "meow@5",
          "when": "editorHasSelection"
        },
        {
          "command": "meow.reviewFile",
          "group": "meow@6"
        },
        {
          "command": "meow.inlineChat",
          "group": "meow@7"
        }
      ],
      "editor/title": [
        {
          "command": "meow.reviewFile",
          "group": "meow",
          "when": "resourceLangId"
        }
      ],
      "commandPalette": [
        {
          "command": "meow.openChat"
        },
        {
          "command": "meow.autopilot"
        },
        {
          "command": "meow.openMemory"
        },
        {
          "command": "meow.analyzeProject"
        },
        {
          "command": "meow.gitSummary"
        }
      ],
      "submenus": [
        {
          "id": "meow.editorContext",
          "label": "🐱 Meow AI"
        }
      ]
    },
    "keybindings": [
      {
        "command": "meow.openChat",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "meow.inlineChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus"
      },
      {
        "command": "meow.explainCode",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorHasSelection"
      },
      {
        "command": "meow.fixCode",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Meow AI Agent",
      "properties": {
        "meow.apiProvider": {
          "type": "string",
          "enum": ["anthropic", "openai", "openrouter", "ollama"],
          "default": "anthropic",
          "description": "AI provider to use"
        },
        "meow.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the selected provider (leave empty to use ~/.meowcli/config.json)",
          "markdownDescription": "API key for the selected provider. Leave empty to inherit from `~/.meowcli/config.json`."
        },
        "meow.model": {
          "type": "string",
          "default": "claude-opus-4-5",
          "description": "Model to use for AI responses"
        },
        "meow.streamResponses": {
          "type": "boolean",
          "default": true,
          "description": "Stream AI responses token by token"
        },
        "meow.maxTokens": {
          "type": "number",
          "default": 8192,
          "description": "Maximum tokens per response"
        },
        "meow.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature for AI responses (creativity)"
        },
        "meow.enableRAG": {
          "type": "boolean",
          "default": true,
          "description": "Enable RAG memory injection into prompts"
        },
        "meow.enableCheckpoints": {
          "type": "boolean",
          "default": true,
          "description": "Create checkpoints before destructive file operations"
        },
        "meow.sandboxMode": {
          "type": "string",
          "enum": ["strict", "workspace", "permissive"],
          "default": "workspace",
          "description": "Sandbox mode: strict (CWD only), workspace (VSCode workspace), permissive (no restriction)"
        },
        "meow.toolPermissions": {
          "type": "object",
          "default": {
            "run_shell": "ask",
            "write_file": "ask",
            "patch_file": "ask",
            "read_file": "allow",
            "list_dir": "allow",
            "grep_search": "allow",
            "git_commit": "ask",
            "web_search": "allow"
          },
          "description": "Default permission levels for each tool (allow/ask/deny)"
        },
        "meow.autopilotBudget": {
          "type": "number",
          "default": 10,
          "description": "Maximum tool calls in autopilot mode before pausing for confirmation"
        },
        "meow.theme": {
          "type": "string",
          "enum": ["auto", "dark", "light", "meow"],
          "default": "auto",
          "description": "UI theme for the chat panel"
        },
        "meow.meowCliPath": {
          "type": "string",
          "default": "",
          "description": "Path to meow CLI executable (leave empty for auto-detection)"
        },
        "meow.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "Custom system prompt prefix to prepend to all requests"
        },
        "meow.showCostTracker": {
          "type": "boolean",
          "default": true,
          "description": "Show token cost in the status bar"
        }
      }
    },
    "statusBar": [
      {
        "id": "meow.status",
        "name": "Meow AI Status",
        "alignment": "right",
        "priority": 100
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node build.js",
    "watch": "node build.js --watch",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "node --test tests/"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0"
  },
  "dependencies": {
    "diff": "^5.2.0"
  }
}
